  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/openapi.cjs",
    "check": "npm run build && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
