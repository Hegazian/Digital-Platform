{
  "name": "@eduplatform/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned runtime schemas and types shared by the platform API and web client.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
