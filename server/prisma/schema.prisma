generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPeriod {
  MONTHLY
  SIX_MONTHS
  YEARLY
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum LessonBlockType {
  VIDEO
  TEXT
  DOCUMENT
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
  LINK
  CODE_PLAYGROUND
  BOARD
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  teacherStatus TeacherStatus? 
  avatar        String?
  gradeId       String?
  
  // Enterprise MFA
  mfaSecret     String?
  mfaEnabled    Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  grade         Grade?         @relation(fields: [gradeId], references: [id])
  courses       Course[]       @relation("TeacherCourses")
  subscriptions Subscription[]
  quizAttempts  QuizAttempt[]
  lessonProgress LessonProgress[]

  orders             Order[]
  entitlements       Entitlement[]
  assessmentAttempts AssessmentAttempt[]
  notifications      Notification[]
  liveSessions       LiveSession[]
  submissions        AssignmentSubmission[] @relation("StudentSubmissions")
  apiTokens          ApiToken[]
  webhooks           WebhookEndpoint[]
  auditLogs          AuditLog[]

  @@map("users")
}



model Subject {
  id          String   @id @default(uuid())
  nameEn      String   // e.g. "Physics 1st Secondary"
  nameAr      String   // e.g. "فيزياء الصف الأول الثانوي"
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses       Course[]
  pricing       SubjectPricing[]
  subscriptions Subscription[]
  gradeSubjects GradeSubject[]
  liveSessions  LiveSession[]

  @@map("subjects")
}

model SubjectPricing {
  id        String             @id @default(uuid())
  subjectId String
  period    SubscriptionPeriod
  priceEgp  Decimal           @db.Decimal(10, 2)
  priceUsd  Decimal           @db.Decimal(10, 2)
  isActive  Boolean           @default(true)
  
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, period])
  @@map("subject_pricing")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
  EXPIRED
}

model Subscription {
  id            String   @id @default(uuid())
  userId        String
  subjectId     String
  period        SubscriptionPeriod
  startDate     DateTime @default(now())
  endDate       DateTime
  
  // Manual Payment Fields
  status        SubscriptionStatus @default(PENDING)
  paymentMethod String?            // e.g. "VODAFONE_CASH", "INSTAPAY"
  transactionId String?            // Mobile number or transaction reference
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([subjectId, status])
  @@map("subscriptions")
}

model Course {
  id             String           @id @default(uuid())
  titleEn        String
  titleAr        String
  description    String
  teacherId      String
  subjectId      String
  academicYearId String?
  gradeId        String?
  slug           String?
  thumbnail      String?
  status         CourseStatus     @default(DRAFT)
  visibility     CourseVisibility @default(PUBLIC)
  isPublished    Boolean          @default(false)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  teacher        User             @relation("TeacherCourses", fields: [teacherId], references: [id])
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sections       Section[]
  modules        CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  titleEn     String
  titleAr     String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("course_modules")
}

model Section {
  id            String   @id @default(uuid())
  courseId      String
  titleEn       String
  titleAr       String
  orderIndex    Int
  isFreePreview Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@map("sections")
}

model Lesson {
  id                String        @id @default(uuid())
  sectionId         String?
  moduleId          String?
  titleEn           String
  titleAr           String
  content           String?       @db.Text // Rich text description
  orderIndex        Int           @default(0)
  estimatedDuration Int?          // In minutes
  videoId           String?       @unique
  quizId            String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  section           Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  module            CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video             Video?        @relation(fields: [videoId], references: [id])
  quiz              Quiz?         @relation(fields: [quizId], references: [id])
  materials         Material[]
  blocks            LessonBlock[]
  progress          LessonProgress[]

  @@map("lessons")
}

model LessonBlock {
  id                String          @id @default(uuid())
  lessonId          String
  blockType         LessonBlockType @default(TEXT)
  configurationJson String          // JSON config: e.g. { mediaId, quizId, assignmentId }
  sortOrder         Int             @default(0)
  isRequired        Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lesson            Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  board             Board?
  playground        Playground?

  @@map("lesson_blocks")
}

model Board {
  id            String      @id @default(uuid())
  lessonBlockId String      @unique
  yjsState      Bytes?
  elementsJson  String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lessonBlock   LessonBlock @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)

  @@map("boards")
}

model Playground {
  id            String      @id @default(uuid())
  lessonBlockId String      @unique
  language      String      @default("python")
  initialCode   String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lessonBlock   LessonBlock @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)

  @@map("playgrounds")
}

model Video {
  id               String      @id @default(uuid())
  teacherId        String
  status           VideoStatus @default(UPLOADING)
  durationSec      Int?
  videoUrl         String      // Supabase storage path or local path
  originalFileName String?
  sizeBytes        Int?
  createdAt        DateTime    @default(now())

  lesson           Lesson?

  @@map("videos")
}

model Material {
  id        String   @id @default(uuid())
  lessonId  String
  title     String
  fileUrl   String
  fileType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Quiz {
  id          String   @id @default(uuid())
  titleEn     String
  titleAr     String
  timeLimit   Int?     // In minutes
  passingScore Int     @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson?
  questions   Question[]
  attempts    QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  questionText  String   @db.Text
  options       Json     // Array of { id, text, isCorrect }
  explanation   String?  @db.Text
  orderIndex    Int
  points        Int      @default(1)

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int      @default(0)
  answers     Json     // Array of { questionId, selectedOptionId }
  isPassed    Boolean  @default(false)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Assignment {
  id                   String                 @id @default(uuid())
  lessonId             String?
  createdById          String
  titleEn              String
  titleAr              String
  description          String?
  instructions         String?
  maxScore             Int                    @default(100)
  dueDate              DateTime?
  allowLateSubmission  Boolean                @default(true)
  maxAttempts          Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  submissions          AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id             String                     @id @default(uuid())
  assignmentId   String
  studentId      String
  submissionText String?                    @db.Text
  status         AssignmentSubmissionStatus @default(SUBMITTED)
  score          Float?
  feedback       String?                    @db.Text
  gradedById     String?
  gradedAt       DateTime?
  submittedAt    DateTime                   @default(now())
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  assignment     Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User                       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  files          AssignmentSubmissionFile[]

  @@map("assignment_submissions")
}

model AssignmentSubmissionFile {
  id           String               @id @default(uuid())
  submissionId String
  fileUrl      String
  fileName     String
  sizeBytes    Int                  @default(0)
  createdAt    DateTime             @default(now())

  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("assignment_submission_files")
}

model LessonProgress {
  id           String   @id @default(uuid())
  userId       String
  lessonId     String
  watchTimeSec Int      @default(0)
  isCompleted  Boolean  @default(false)
  lastWatched  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@map("lesson_progress")
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   // e.g. "2026/2027"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gradeSubjects GradeSubject[]

  @@map("academic_years")
}

model EducationalStage {
  id        String   @id @default(uuid())
  nameEn    String   // e.g. "Secondary Education"
  nameAr    String   // e.g. "التعليم الثانوي"
  code      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades    Grade[]

  @@map("educational_stages")
}

model Grade {
  id        String   @id @default(uuid())
  stageId   String
  nameEn    String   // e.g. "1st Secondary"
  nameAr    String   // e.g. "الصف الأول الثانوي"
  code      String   // e.g. "SEC_1"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage         EducationalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  gradeSubjects GradeSubject[]
  students      User[]

  @@map("grades")
}

model GradeSubject {
  id             String   @id @default(uuid())
  gradeId        String
  subjectId      String
  academicYearId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([gradeId, subjectId, academicYearId])
  @@map("grade_subjects")
}

enum ProductType {
  COURSE
  SUBJECT
  GRADE_BUNDLE
  VOUCHER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MANUAL
  PAYMOB
  FAWRY
  VOUCHER
}

enum EntitlementType {
  COURSE
  SUBJECT
  GRADE_BUNDLE
}

enum EntitlementSource {
  PURCHASE
  SUBSCRIPTION
  VOUCHER
  ADMIN_GRANT
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Product {
  id          String      @id @default(uuid())
  nameEn      String
  nameAr      String
  description String?
  productType ProductType
  resourceId  String?
  priceEgp    Decimal     @db.Decimal(10, 2)
  priceUsd    Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders      Order[]

  @@map("products")
}

model Order {
  id             String        @id @default(uuid())
  studentId      String
  productId      String
  status         OrderStatus   @default(PENDING)
  totalAmountEgp Decimal       @db.Decimal(10, 2)
  totalAmountUsd Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(MANUAL)
  transactionRef String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id])
  entitlements   Entitlement[]

  @@index([studentId, status])
  @@map("orders")
}

model Entitlement {
  id           String            @id @default(uuid())
  studentId    String
  orderId      String?
  resourceType EntitlementType
  resourceId   String
  sourceType   EntitlementSource @default(PURCHASE)
  startsAt     DateTime          @default(now())
  expiresAt    DateTime?
  status       EntitlementStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([resourceType, resourceId, status])
  @@map("entitlements")
}

model Voucher {
  id           String          @id @default(uuid())
  code         String          @unique
  resourceType EntitlementType
  resourceId   String
  durationDays Int             @default(30)
  maxUses      Int             @default(1)
  usedCount    Int             @default(0)
  expiresAt    DateTime?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  @@map("vouchers")
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  ESSAY
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model QuestionPool {
  id          String         @id @default(uuid())
  titleEn     String
  titleAr     String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  questions   QuestionItem[]
  assessments Assessment[]

  @@map("question_pools")
}

model QuestionItem {
  id                String             @id @default(uuid())
  poolId            String
  textEn            String
  textAr            String
  questionType      QuestionType       @default(MCQ)
  difficulty        QuestionDifficulty @default(MEDIUM)
  optionsJson       String             // JSON string array of choices e.g. ["A", "B", "C", "D"]
  correctAnswerJson String             // JSON string of correct answer
  explanation       String?
  points            Int                @default(10)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  pool              QuestionPool       @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("question_items")
}

model Assessment {
  id              String              @id @default(uuid())
  poolId          String
  titleEn         String
  titleAr         String
  durationMinutes Int                 @default(30)
  passingScore    Int                 @default(60)
  totalQuestions  Int                 @default(10)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  pool            QuestionPool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  attempts        AssessmentAttempt[]

  @@map("assessments")
}

model AssessmentAttempt {
  id                    String                  @id @default(uuid())
  assessmentId          String
  studentId             String
  startedAt             DateTime                @default(now())
  submittedAt           DateTime?
  expiresAt             DateTime
  score                 Float?
  isPassed              Boolean?
  status                AssessmentAttemptStatus @default(IN_PROGRESS)
  questionsSnapshotJson String                  // Frozen snapshot JSON array of questions
  studentAnswersJson    String?                 // Student submitted answers JSON array
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  assessment            Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student               User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("assessment_attempts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  titleEn   String
  titleAr   String
  messageEn String
  messageAr String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model LiveSession {
  id              String   @id @default(uuid())
  teacherId       String
  subjectId       String
  titleEn         String
  titleAr         String
  startTime       DateTime
  durationMinutes Int
  zoomMeetingId   String
  zoomJoinUrl     String
  zoomStartUrl    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, startTime])
  @@map("live_sessions")
}



model AppConfig {
  id                        String   @id @default(uuid())
  siteNameEn                String   @default("EduPlatform")
  siteNameAr                String   @default("منصة التعليم")
  siteDescriptionEn         String?
  siteDescriptionAr         String?
  allowTeacherRegistration  Boolean  @default(true)
  enableCodePlaygrounds     Boolean  @default(true)
  enableCollaborativeBoards Boolean  @default(true)
  primaryColor              String   @default("#000000")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("app_configs")
}

model DiscussionThread {
  id        String   @id @default(uuid())
  courseId  String
  lessonId  String?
  authorId  String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies   DiscussionReply[]

  @@index([courseId])
  @@map("discussion_threads")
}

model DiscussionReply {
  id        String           @id @default(uuid())
  threadId  String
  authorId  String
  content   String           @db.Text
  createdAt DateTime         @default(now())

  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("discussion_replies")
}

model Podcast {
  id          String           @id @default(uuid())
  titleEn     String
  titleAr     String
  description String?          @db.Text
  coverImage  String?
  authorId    String
  createdAt   DateTime         @default(now())

  episodes    PodcastEpisode[]

  @@map("podcasts")
}

model PodcastEpisode {
  id          String   @id @default(uuid())
  podcastId   String
  titleEn     String
  titleAr     String
  audioUrl    String
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  podcast     Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@map("podcast_episodes")
}

model Certificate {
  id              String   @id @default(uuid())
  userId          String
  courseId        String
  certificateCode String   @unique
  issuedAt        DateTime @default(now())
  pdfUrl          String?

  @@map("certificates")
}

model Collection {
  id          String             @id @default(uuid())
  titleEn     String
  titleAr     String
  slug        String             @unique
  description String?            @db.Text
  thumbnail   String?
  isPublished Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  courses     CollectionCourse[]

  @@map("collections")
}

model CollectionCourse {
  id           String     @id @default(uuid())
  collectionId String
  courseId     String
  sortOrder    Int        @default(0)

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, courseId])
  @@map("collection_courses")
}

model ApiToken {
  id        String   @id @default(uuid())
  userId    String
  name      String
  tokenHash String   @unique
  scopes    String[] // e.g. ["read:users", "write:enrollments"]
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  userId    String
  url       String
  events    String[] // e.g. ["user.created", "course.completed"]
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhook_endpoints")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entityId  String?
  entityType String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([entityId, entityType])
  @@map("audit_logs")
}
