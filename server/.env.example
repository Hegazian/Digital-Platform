# Server Environment Variables Template
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/eduplatform"
DIRECT_URL="postgresql://user:password@localhost:5432/eduplatform"

# REQUIRED in production (>=32 chars). Server refuses to boot otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# Optional dedicated key for signed local-video streaming URLs (falls back to JWT_SECRET)
VIDEO_STREAM_SECRET=""

# Local file storage root for uploaded videos/materials. Leave empty to use
# <server-package>/uploads (independent of the directory the server was
# launched from). Set an absolute path for custom volume mounts.
UPLOADS_DIR=""

# Payment gateways, code execution, boards and developer integrations are
# hard disabled at API boundaries. Environment flags cannot enable them.

RESEND_API_KEY=""
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
# Keep lesson-materials, lesson-videos and submission-files buckets private.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Production uploads fail closed unless ClamAV is reachable and clean.
# Configure clamd StreamMaxLength to cover the 500 MB video upload ceiling.
CLAMAV_HOST=""
CLAMAV_PORT=3310
