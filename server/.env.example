# Server Environment Variables Template
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/eduplatform"

# REQUIRED in production (>=32 chars). Server refuses to boot otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# Optional dedicated key for signed local-video streaming URLs (falls back to JWT_SECRET)
VIDEO_STREAM_SECRET=""

# Local file storage root for uploaded videos/materials. Leave empty to use
# <server-package>/uploads (independent of the directory the server was
# launched from). Set an absolute path for custom volume mounts.
UPLOADS_DIR=""

# Payment webhook HMAC keys. Required in production; signatures fail closed without them.
PAYMOB_HMAC_SECRET=""
FAWRY_SECRET_KEY=""

# Untrusted code execution. Leave DISABLED unless the server runs inside a
# dedicated OS-level sandbox container with no network access and no secrets.
CODE_EXECUTION_ENABLED="false"

RESEND_API_KEY="re_test_key"
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
GEMINI_API_KEY=""
